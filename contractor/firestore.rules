rules_version = '2';
// Crew chat: anyone signed in to the app (anonymous sign-in) can read the room and post.
// A message can't be edited, only deleted by whoever sent it. Paste this into
// Firebase console > Firestore Database > Rules and press Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{room}/messages/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'trade', 'text', 'sheet', 'uid', 'at'])
        && request.resource.data.keys().hasAll(['name', 'text', 'uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && (!('trade' in request.resource.data) || (request.resource.data.trade is string && request.resource.data.trade.size() <= 40))
        && (!('sheet' in request.resource.data) || (request.resource.data.sheet is string && request.resource.data.sheet.size() <= 120));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
