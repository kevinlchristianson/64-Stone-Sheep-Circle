// Cloudflare Worker for 64 Stone Sheep Circle: the whole repo as static files,
// plus /api/* (worker/index.js), a small store that keeps the property app's
// budget in step between devices.
//   Public:  /  and  /contractor/*   (the crews' app, chat included)
//   Private: /property/*  and  /api/*  (only through Cloudflare Access)
{
  "name": "64-stone-sheep-circle",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Serve each file at its own name (home.html stays home.html); the
    // service workers' cache lists rely on it.
    "html_handling": "none",
    // Every request goes through worker/index.js first, so the private paths
    // are checked before any file is served.
    "run_worker_first": true
  },
  // Cloudflare Access team name (the part before .cloudflareaccess.com) and the
  // Access application's Audience (AUD) tag. Until both are set, the private
  // paths answer "finish the Access setup" instead of serving anything.
  "vars": { "ACCESS_TEAM": "lingering-field-6a7f", "ACCESS_AUD": "29f208a85c285c140efe24726e968a3c2577498c5891cfc79550b6c91236c57d" },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }]
}
